{
  "opencollection": "1.0.0",
  "info": {
    "name": "Signal AI Affinity Events API",
    "version": "v1.3"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.signal-ai.com/auth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Returns the Event for this hash",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.signal-ai.com/events/:hash",
            "params": [
              {
                "name": "hash",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the Event for this hash"
        },
        {
          "info": {
            "name": "Events Search",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.signal-ai.com/events",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.signal-ai.com/auth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Events Search"
        }
      ]
    }
  ],
  "bundled": true
}