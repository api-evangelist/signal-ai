{
  "opencollection": "1.0.0",
  "info": {
    "name": "Signal AI Organisation API",
    "version": "v1.3"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.signal-ai.com/auth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Organisation",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users in your organisation",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.signal-ai.com/users",
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.signal-ai.com/auth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Returns all users in the organisation of the authenticated API credential. Requires a credential with the `manage-organisation` capability, granted to organisation administrators."
        }
      ]
    }
  ],
  "bundled": true
}