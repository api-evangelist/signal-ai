{
  "opencollection": "1.0.0",
  "info": {
    "name": "Signal AI Affinity Categories API",
    "version": "v1.3"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.signal-ai.com/auth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Categories",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all categories for IPTC Media Topics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.signal-ai.com/categories/iptc-media-topics"
          },
          "docs": "Get all categories for IPTC Media Topics"
        },
        {
          "info": {
            "name": "Get an IPTC Media Topics category by id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.signal-ai.com/categories/iptc-media-topics/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get an IPTC Media Topics category by id"
        }
      ]
    }
  ],
  "bundled": true
}